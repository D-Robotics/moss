  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "moss": "dist/cli.js"
  },
  "files": [
    "assets",
    "dist",
    "src",
    "zero-config-default.json",
    "bundled-search-key.json",
    "README.md",
    "README.zh-CN.md",
    "USAGE.md",
    "API.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/D-Robotics/moss.git",
    "directory": "packages/moss-agent"
  },
  "bugs": {
    "url": "https://github.com/D-Robotics/moss/issues"
  },
  "homepage": "https://github.com/D-Robotics/moss/tree/main/packages/moss-agent#readme",
  "scripts": {
    "prebuild": "npm run build --workspace @rdk-moss/core",
    "build": "npm run clean && tsc -p tsconfig.build.json && node -e \"const fs=require('fs');fs.chmodSync('dist/cli.js',0o755)\"",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "postinstall": "node -e \"const fs=require('fs');try{fs.chmodSync('dist/cli.js',0o755)}catch{}\"",
    "prepack": "node scripts/prepare-zero-config-default.mjs && node scripts/prepare-bundled-search-key.mjs",
    "postpack": "node scripts/cleanup-zero-config-default.mjs && node scripts/cleanup-bundled-search-key.mjs",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "npm run build && node ../../scripts/run-package-tests.mjs",
    "cli": "npx tsx src/cli.ts",
    "sync:knowledge": "node scripts/sync-device-knowledge.mjs",
    "docs": "typedoc --out docs-api src/index.ts src/core/index.ts src/knowledge/index.ts --tsconfig tsconfig.build.json"
  },
  "dependencies": {
    "@rdk-moss/core": "^0.6.0",
    "ink": "^7.0.5",
    "marked": "^5.1.0",
    "marked-terminal": "^7.0.0",
    "micromatch": "^4.0.8",
    "picocolors": "^1.1.1",
    "puppeteer-core": "^25.1.0",
    "react": "^19.2.6",
    "string-width": "^8.2.1",
    "turndown": "^7.2.0",
    "undici": "^7.19.1",
    "highlight.js": "^10.7.3"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@types/micromatch": "^4.0.10",
    "@types/react": "^19.2.0",
    "@types/turndown": "^5.0.5",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "keywords": [
    "moss",
    "agent",
    "agent-harness",
    "coding-assistant",
    "cli",
    "cross-platform",
    "robotics",
    "skill",
    "llm",
