#!/usr/bin/env bash
# Simulated dpkg-deb --build. Writes a tar the sim dpkg can extract.
set -eu
if [ "${1:-}" != "--build" ] || [ -z "${2:-}" ]; then
  echo "sim dpkg-deb: only --build DIR [DEB]" >&2
  exit 1
fi
dir="$2"
dest="${3:-$dir.deb}"
dir="$(cd "$dir" && pwd)"
mkdir -p "$(dirname "$dest")"
# A Windows drive prefix in an archive name means a remote host to GNU tar.
# Relative archive names also work with BSD tar, without GNU-only flags.
(cd "$(dirname "$dest")" && tar -C "$dir" -cf "$(basename "$dest")" .)
