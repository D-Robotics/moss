# Applies only to npm ci / npm install run inside this repo. Those commands
# refuse before downloading dependencies when Node is older than package.json
# "engines". npm install -g ignores this file (global mode does not load
# project config). `npm install -g --install-links .` is stopped by
# scripts/check-node-version.cjs at the start of the prepare script, before
# npm links the global bin.
engine-strict=true
