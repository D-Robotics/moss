{
  "name": "moss",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Moss: a minimal cross-platform coding agent harness (agent loop, tools, context management, providers) with a `moss` CLI.",
  "bin": {
    "moss": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node -e \"const fs=require('fs');fs.chmodSync('dist/cli.js',0o755)\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node scripts/run-package-tests.mjs",
    "test:filter": "node scripts/run-package-tests.mjs",
    "smoke": "node scripts/smoke-moss-cli.mjs",
    "bench": "npm run build && node scripts/run-benchmark.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "verify": "npm run check && npm run test && npm run smoke"
  },
  "dependencies": {
    "highlight.js": "^10.7.3",
    "marked": "^5.1.0",
    "marked-terminal": "^7.0.0",
    "micromatch": "^4.0.8",
    "picocolors": "^1.1.1",
    "proper-lockfile": "4.1.2",
    "string-width": "^8.2.1",
    "turndown": "^7.2.0",
    "undici": "^7.29.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/marked": "^5.0.1",
    "@types/marked-terminal": "^6.1.1",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^22.10.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/turndown": "^5.0.5",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "prettier": "3.8.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.66.0"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "keywords": [
    "moss",
    "agent",
    "agent-harness",
    "coding-assistant",
    "cli",
    "llm",
    "tools"
  ]
}
