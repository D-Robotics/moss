{
  "name": "moss-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Moss open-source workspace: runtime, agent, memory, skills, teaching, and scaffolding packages.",
  "workspaces": [
    "packages/moss",
    "packages/moss-agent",
    "packages/create-moss-app"
  ],
  "scripts": {
    "clean": "npm run clean --workspaces --if-present",
    "build": "npm run clean && npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "docs": "npm run docs --workspaces --if-present",
    "test": "npm run test -w @rdk-moss/core && npm run test -w @rdk-moss/agent && npm run test -w create-moss-app",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test:standards": "node --test scripts/test/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:files": "node scripts/list-prettier-files.mjs",
    "check:boundaries": "node scripts/check-oss-boundaries.mjs",
    "check:hygiene": "node scripts/check-workspace-hygiene.mjs",
    "check:maintainability": "node scripts/check-maintainability.mjs",
    "check:vendored": "node scripts/check-vendored-sources.mjs",
    "check:pr-title": "node scripts/check-pr-title.mjs",
    "check:agent-harness-benchmark": "node scripts/check-agent-harness-benchmark.mjs",
    "check:leaderboard-readiness": "node scripts/check-leaderboard-readiness.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:boundaries && npm run check:hygiene && npm run check:vendored && npm run check:maintainability && npm run test:standards",
    "api:check": "npm run build && node scripts/check-api.mjs",
    "api:update": "npm run build && node scripts/check-api.mjs --update",
    "smoke:moss-cli": "node scripts/smoke-moss-cli.mjs",
    "demo:capabilities": "npm run build -w @rdk-moss/agent && node scripts/demo-moss-capabilities.mjs",
    "demo:cloud-local": "npm run build -w @rdk-moss/agent && node scripts/demo-cloud-local-recovery.mjs",
    "demo:multi-model-review": "npm run build -w @rdk-moss/agent && node scripts/demo-multi-model-review.mjs",
    "release:rdk-moss": "node scripts/release-rdk-moss.mjs",
    "verify": "npm run check && npm run check:agent-harness-benchmark && npm run api:check && npm run docs && npm run test",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.58.12",
    "@types/node": "^22.10.2",
    "eslint": "10.8.1",
    "eslint-plugin-tsdoc": "0.5.2",
    "globals": "17.9.0",
    "prettier": "3.8.3",
    "typedoc": "0.28.20",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.66.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
