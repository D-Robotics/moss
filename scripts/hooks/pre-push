#!/bin/bash
# Moss pre-push hook: delegate to the repository's canonical fast quality gate.
# `npm run check` prepares core declarations before dependent type checking, so
# contributors do not need a pre-existing packages/moss/dist directory.

set -e

echo "🔍 Running canonical pre-push quality gate: npm run check"
echo ""

if ! npm run check; then
  echo ""
  echo "❌ PUSH BLOCKED: npm run check failed"
  echo "   Fix the reported formatting, lint, type, boundary, hygiene, or maintainability issue."
  echo "   Reproduce with: npm run check"
  exit 1
fi

echo ""
echo "✅ npm run check passed. Pushing to remote…"
